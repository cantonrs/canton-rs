module Main where

import TaggedIface

template Vault
  with
    owner : Party
    balance : Int
    tag : Text
  where
    signatory owner
    key owner : Party
    maintainer key

    interface instance Tagged for Vault where
      view = TagView with label = tag
      getOwner = owner
      getLabel = tag

    choice Bump : ContractId Vault
      with
        delta : Int
      controller owner
      do create this with balance = balance + delta
