# canton-rs Prometheus + Grafana Monitoring Stack Environment Defaults
PROMETHEUS_PORT=9095
GRAFANA_PORT=3300
GRAFANA_ADMIN_USER=admin
# Set a strong password in .env before starting Grafana
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_BEFORE_START
# Disabled by default so Grafana always requires login
GRAFANA_ANONYMOUS_ENABLED=false

# Switch Prometheus profile if testing multi-host federation or JVM shadow-verify:
# PROMETHEUS_CONFIG=./prometheus/prometheus.yml
# PROMETHEUS_CONFIG=./prometheus/prometheus-federation.yml
# PROMETHEUS_CONFIG=./prometheus/prometheus-hybrid-shadow.yml
