exerciseRename : Script Text
exerciseRename = do
  (a, _, pa, _) <- setup
  _ <- submit a (createCmd (item a "k" "n1"))
  _ <- submit a (createCmd (item a "k" "n2"))
  r <- trySubmit a (exerciseCmd pa (ExerciseRename a "k" "z"))
  s <- acsNotes a
  pure (out [cat (fmap (const "cid") r)] s)

