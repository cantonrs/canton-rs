-- U-4: explicit disclosure (`disclose`) & NUCK key precedence scenarios
discloseFetch : Script Text
discloseFetch = do
  (a, b, _, _) <- setup
  relay <- submit a (createCmd (DiscRelay a b))
  cid <- submit a (createCmd (item a "k" "secret"))
  Some d <- queryDisclosure @Item a cid
  r1 <- trySubmit b (exerciseCmd relay (RelayFetchItem cid))
  r2 <- trySubmit (actAs b <> disclose d) (exerciseCmd relay (RelayFetchItem cid))
  pure (out [cat r1, cat r2] "")

discloseExercise : Script Text
discloseExercise = do
  (a, b, _, _) <- setup
  cid <- submit a (createCmd (DiscBox a b "open-sesame"))
  Some d <- queryDisclosure @DiscBox a cid
  r1 <- trySubmit b (exerciseCmd cid OpenByViewer)
  r2 <- trySubmit (actAs b <> disclose d) (exerciseCmd cid OpenByViewer)
  pure (out [cat r1, cat r2] "")

discloseLookupByKey : Script Text
discloseLookupByKey = do
  (a, b, _, _) <- setup
  relay <- submit a (createCmd (DiscRelay a b))
  cid <- submit a (createCmd (item a "k" "d1"))
  Some d <- queryDisclosure @Item a cid
  r1 <- trySubmit b (exerciseCmd relay (RelayLookupItem a "k"))
  r2 <- trySubmit (actAs b <> disclose d) (exerciseCmd relay (RelayLookupItem a "k"))
  pure (out [cat (fmap show r1), cat (fmap show r2)] "")

discloseFetchByKey : Script Text
discloseFetchByKey = do
  (a, b, _, _) <- setup
  relay <- submit a (createCmd (DiscRelay a b))
  cid <- submit a (createCmd (item a "k" "d1"))
  Some d <- queryDisclosure @Item a cid
  r1 <- trySubmit b (exerciseCmd relay (RelayFetchByKeyItem a "k"))
  r2 <- trySubmit (actAs b <> disclose d) (exerciseCmd relay (RelayFetchByKeyItem a "k"))
  pure (out [cat r1, cat r2] "")

discloseQueryNOrder : Script Text
discloseQueryNOrder = do
  (a, b, _, _) <- setup
  relay <- submit a (createCmd (DiscRelay a b))
  d1c <- submit a (createCmd (item a "k" "disclosed-old"))
  Some d1 <- queryDisclosure @Item a d1c
  _ <- submit a (createCmd (item a "k" "global-new"))
  r <- trySubmit (actAs b <> readAs a <> disclose d1) (exerciseCmd relay (RelayCreateThenQueryNItem 10 "k"))
  out [cat (fmap showNotes r)] <$> acsNotes a

discloseCallerOrder : Script Text
discloseCallerOrder = do
  (a, b, _, _) <- setup
  relay <- submit a (createCmd (DiscRelay a b))
  c1 <- submit a (createCmd (item a "k" "d1"))
  _ <- submit a (createCmd (item a "k" "d2"))
  c3 <- submit a (createCmd (item a "k" "d3"))
  Some d1 <- queryDisclosure @Item a c1
  Some d3 <- queryDisclosure @Item a c3
  r1 <- trySubmit (actAs b <> disclose d1 <> disclose d3) (exerciseCmd relay (RelayQueryNItem 10 a "k"))
  r2 <- trySubmit (actAs b <> disclose d3 <> disclose d1) (exerciseCmd relay (RelayQueryNItem 10 a "k"))
  r3 <- trySubmit (actAs b <> disclose d3 <> disclose d1) (exerciseCmd relay (RelayFetchByKeyItem a "k"))
  pure (out [cat (fmap showNotes r1), cat (fmap showNotes r2), cat r3] "")

discloseArchivedNone : Script Text
discloseArchivedNone = do
  (a, b, _, _) <- setup
  relay <- submit a (createCmd (DiscRelay a b))
  cid <- submit a (createCmd (item a "k" "v1"))
  Some d <- queryDisclosure @Item a cid
  submit a (archiveCmd cid)
  r1 <- trySubmit (actAs b <> disclose d) (exerciseCmd relay (RelayLookupItem a "k"))
  r2 <- trySubmit (actAs b <> disclose d) (exerciseCmd relay (RelayFetchItem cid))
  pure (out [cat (fmap show r1), cat r2] "")

discloseNoAuthority : Script Text
discloseNoAuthority = do
  (a, b, _, pb) <- setup
  cid <- submit a (createCmd (item a "k" "secret"))
  Some d <- queryDisclosure @Item a cid
  r1 <- trySubmit b (exerciseCmd cid Peek)
  r2 <- trySubmit (actAs b <> disclose d) (exerciseCmd cid Peek)
  r3 <- trySubmit (actAs b <> disclose d) (exerciseCmd pb (FetchNote a "k"))
  pure (out [cat r1, cat r2, cat r3] "")

discloseWithReadAs : Script Text
discloseWithReadAs = do
  (a, b, _, _) <- setup
  relay <- submit a (createCmd (DiscRelay a b))
  c1 <- submit a (createCmd (item a "k" "d1"))
  _ <- submit a (createCmd (item a "k" "g2"))
  Some d1 <- queryDisclosure @Item a c1
  r1 <- trySubmit (actAs b <> readAs a) (exerciseCmd relay (RelayQueryNItem 10 a "k"))
  r2 <- trySubmit (actAs b <> readAs a <> disclose d1) (exerciseCmd relay (RelayQueryNItem 10 a "k"))
  pure (out [cat (fmap showNotes r1), cat (fmap showNotes r2)] "")

-- All scenarios in one run, in this order (scripts/verify-key-diff.sh pairs the answers with these names).
runAll : Script [Text]
runAll = sequence
  [ fetchOne
  , fetchMostRecent
  , fetchMissing
  , fetchOtherLabel
  , fetchAfterArchive
  , fetchAfterArchiveLatest
  , fetchByOther
  , fetchByOtherReadAs
  , lookupByOtherReadAs
  , lookupByOtherWithoutReadAs
  , exerciseOtherReadAs
  , exerciseOne
  , exerciseMissing
  , exerciseRename
  , queryN2
  , queryN5
  , queryNMissing
  , queryNAfterArchive
  , queryNZero
  , queryNUnauthorized
  , lookupSome
  , lookupNone
  , createThenFetch
  , createTwiceThenQuery
  , rolledBack
  , caughtMissing
  , noMaintainers
  , badMaintainers
  , rolledBackPlain
  , rbArchive
  , rbExerciseConsuming
  , rbNonConsuming
  , rbFetch
  , rbNoThrow
  , rbNested
  , rbInnerOk
  , rbUncaught
  , rbEnsure
  , rbCreateThenArchive
  , rbDeepNested
  , rbNestedFailedExercise
  , rbEffectBeforeTry
  , rbEffectInHandler
  , rbIfaceConsume
  , rbIfacePeek
  , rbIfaceRename
  , rbIfaceConsumeKept
  , rbIfaceBeforeTry
  , rbIfaceInHandler
  , coercePeek
  , validateKeyOk
  , validateKeyCompressed
  , validateKeyOffCurve
  , validateKeyOther
  , validateKeyGarbage
  , authCreateMissing
  , authNoSignatories
  , authNoControllers
  , authFetchMulti3ReadAs
  , authFetchMulti5ReadAs
  , authNestedNodeId
  , authNestedFetchNodeId
  , wrongTypeFetch
  , wrongTypeExercise
  , notActiveExercise
  , notVisibleExercise
  , wrongTypeInvisible
  , failAbort
  , failAssert
  , discloseFetch
  , discloseExercise
