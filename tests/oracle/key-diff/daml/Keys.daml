authFetchMulti3ReadAs : Script Text
authFetchMulti3ReadAs = do
  p1 <- allocateParty "P1"
  p2 <- allocateParty "P2"
  p3 <- allocateParty "P3"
  p4 <- allocateParty "P4"
  p4p <- submit p4 (createCmd (Prober p4))
  cid <- submit (actAs p1 <> actAs p2 <> actAs p3) (createCmd (MultiSig3 p1 p2 p3))
  r <- trySubmit (actAs p4 <> readAs p1) (exerciseCmd p4p (FetchMulti3 cid))
  pure (out [cat (fmap (const "ok") r)] "")

authFetchMulti5ReadAs : Script Text
authFetchMulti5ReadAs = do
  p1 <- allocateParty "P1"
  p2 <- allocateParty "P2"
  p3 <- allocateParty "P3"
  p4 <- allocateParty "P4"
  p5 <- allocateParty "P5"
  p6 <- allocateParty "P6"
  p6p <- submit p6 (createCmd (Prober p6))
  cid <- submit (actAs p1 <> actAs p2 <> actAs p3 <> actAs p4 <> actAs p5) (createCmd (MultiSig5 p1 p2 p3 p4 p5))
  r <- trySubmit (actAs p6 <> readAs p1) (exerciseCmd p6p (FetchMulti5 cid))
  pure (out [cat (fmap (const "ok") r)] "")

