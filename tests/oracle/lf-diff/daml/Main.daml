template AnyBoxA
  with
    n : Int
  where
    signatory ([] : [Party])

template AnyBoxB
  with
    n : Int
  where
    signatory ([] : [Party])

exception CodeErr
  with
    code : Int
  where
    message "code " <> show code <> "!"

-- plain (non-template) records tagged through the compiler primitives; damlc accepts them only at a type
-- constructor without arguments, so type keys with arguments are covered by the contract-key harness instead
data AnyRecA = AnyRecA with n : Int
data AnyRecB = AnyRecB with n : Int

toAnyRecA : AnyRecA -> AnyTemplate
toAnyRecA r = AnyTemplate (primitive @"EToAnyTemplate" r)

fromAnyRecA : AnyTemplate -> Optional AnyRecA
fromAnyRecA (AnyTemplate a) = primitive @"EFromAnyTemplate" a

fromAnyRecB : AnyTemplate -> Optional AnyRecB
fromAnyRecB (AnyTemplate a) = primitive @"EFromAnyTemplate" a

repRecA : TemplateTypeRep
repRecA = TemplateTypeRep (primitive @"ETemplateTypeRep" ([] : [AnyRecA]))

repRecB : TemplateTypeRep
repRecB = TemplateTypeRep (primitive @"ETemplateTypeRep" ([] : [AnyRecB]))

-- AT-L07: Daml-LF has no local recursion (damlc: `recursion can only happen at the top level`), so every recursive function is top-level
recSumH : Int -> Int
recSumH k = if k <= 0 then 0 else k + recSumH (k - 1)

tailSumH : Int -> Int -> Int
tailSumH acc k = if k <= 0 then acc else tailSumH (acc + k) (k - 1)

deepErrH : Int -> Int
deepErrH k = if k <= 0 then error "bottom" else 1 + deepErrH (k - 1)

composeH : Int -> Int -> Int -> Int
composeH step acc k = if k <= 0 then acc else composeH step (acc + step) (k - 1)

isEvenH : Int -> Bool
isEvenH k = if k == 0 then True else isOddH (k - 1)

isOddH : Int -> Bool
isOddH k = if k == 0 then False else isEvenH (k - 1)

