-- DA.Text.replace
replaceText : Text -> Text -> Text -> Text
replaceText x y z = T.replace x y z

-- DA.Text.isInfixOf
infixText : Text -> Text -> Bool
infixText x y = T.isInfixOf x y

-- DA.Text.isPrefixOf
prefixText : Text -> Text -> Bool
prefixText x y = T.isPrefixOf x y

-- DA.Text.splitOn
splitOnText : Text -> Text -> Text
splitOnText x y = T.intercalate "|" (T.splitOn x y)

-- recursion (not a tail call)
recSum : Int -> Int
recSum x = recSumH x

-- recursion (tail call)
tailSum : Int -> Int
tailSum x = tailSumH 0 x

-- foldl over a list
foldlSum : Int -> Int
foldlSum x = foldl (+) 0 [1 .. x]

-- foldr over a list
foldrSum : Int -> Int
foldrSum x = foldr (+) 0 [1 .. x]

-- mutual recursion (top-level)
mutualEven : Int -> Bool
mutualEven x = isEvenH x

-- an error at the bottom of a deep recursion
deepError : Int -> Int
deepError x = deepErrH x

-- a closure over an argument
closureMap : Int -> Int -> Int
closureMap x y = sum (map ((+) x) (map (* 2) [1 .. y]))

-- partial application in three steps
partialApp : Int -> Int -> Int
partialApp x y =
  let add3 : Int -> Int -> Int -> Int
      add3 a b c = a * 100 + b * 10 + c
      g = add3 x
      h = g y
  in h 3

-- a composed function applied many times
composeMany : Int -> Int -> Int
composeMany x y = composeH x 0 y

