-- UNIX_MICROSECONDS_TO_TIMESTAMP+TIMESTAMP_TO_TEXT
tsFromMicros : Int -> Text
tsFromMicros x = show (addRelTime (time (date 1970 Jan 1) 0 0 0) (microseconds x))

-- UNIX_MICROSECONDS_TO_TIMESTAMP+TIMESTAMP_TO_UNIX_MICROSECONDS
tsRoundTrip : Int -> Int
tsRoundTrip x = convertRelTimeToMicroseconds (subTime (addRelTime (time (date 1970 Jan 1) 0 0 0) (microseconds x)) (time (date 1970 Jan 1) 0 0 0))

-- UNIX_DAYS_TO_DATE+DATE_TO_TEXT
dateFromDays : Int -> Text
dateFromDays x = show (addDays (date 1970 Jan 1) x)

-- UNIX_DAYS_TO_DATE+DATE_TO_UNIX_DAYS
dateRoundTrip : Int -> Int
dateRoundTrip x = subDate (addDays (date 1970 Jan 1) x) (date 1970 Jan 1)

-- ADD_TIMESTAMP (addRelTime)
tsAdd : Int -> Int -> Text
tsAdd x y = show (addRelTime (addRelTime (time (date 1970 Jan 1) 0 0 0) (microseconds x)) (microseconds y))

-- SUB_TIMESTAMP (subTime)
tsDiff : Int -> Int -> Int
tsDiff x y = convertRelTimeToMicroseconds (subTime (addRelTime (time (date 1970 Jan 1) 0 0 0) (microseconds x)) (addRelTime (time (date 1970 Jan 1) 0 0 0) (microseconds y)))

-- LESS (Timestamp)
tsLess : Int -> Int -> Bool
tsLess x y = (addRelTime (time (date 1970 Jan 1) 0 0 0) (microseconds x)) < (addRelTime (time (date 1970 Jan 1) 0 0 0) (microseconds y))

-- EQUAL (Timestamp)
tsEq : Int -> Int -> Bool
tsEq x y = (addRelTime (time (date 1970 Jan 1) 0 0 0) (microseconds x)) == (addRelTime (time (date 1970 Jan 1) 0 0 0) (microseconds y))

-- TIMESTAMP_TO_UNIX_DAYS (toDateUTC)
tsToDate : Int -> Text
tsToDate x = show (toDateUTC (addRelTime (time (date 1970 Jan 1) 0 0 0) (microseconds x)))

-- fromGregorian (DA.Date.date)
dateOf : Int -> Int -> Int -> Text
dateOf x y z = show (date x (toEnum y) z)

-- toGregorian
dateParts : Int -> Text
dateParts x = let (a, b, c) = toGregorian (addDays (date 1970 Jan 1) x) in show a <> "/" <> show (fromEnum b) <> "/" <> show c

-- dayOfWeek
dateWeekday : Int -> Text
dateWeekday x = show (dayOfWeek (addDays (date 1970 Jan 1) x))

-- isLeapYear
dateLeap : Int -> Bool
dateLeap x = isLeapYear x

-- monthDayCount
dateMonthDays : Int -> Int -> Int
dateMonthDays x y = monthDayCount x (toEnum y)

-- subDate
dateDiff : Int -> Int -> Int
dateDiff x y = subDate (addDays (date 1970 Jan 1) x) (addDays (date 1970 Jan 1) y)

-- TO_ANY_TEMPLATE+FROM_ANY_TEMPLATE
anyTemplateRoundTrip : Int -> Int
anyTemplateRoundTrip x =
  case fromAnyTemplate @AnyBoxA (toAnyTemplate (AnyBoxA x)) of
    Some b -> b.n
    None -> -1

-- TO_ANY_TEMPLATE+FROM_ANY_TEMPLATE (other template)
anyTemplateWrong : Int -> Int
anyTemplateWrong x =
  case fromAnyTemplate @AnyBoxB (toAnyTemplate (AnyBoxA x)) of
    Some b -> b.n
    None -> -1

-- TO_ANY+FROM_ANY (plain record)
anyRecordRoundTrip : Int -> Int
anyRecordRoundTrip x =
  case fromAnyRecA (toAnyRecA (AnyRecA x)) of
    Some r -> r.n
    None -> -1

-- TO_ANY+FROM_ANY (other record of the same shape)
anyRecordWrong : Int -> Int
anyRecordWrong x =
  case fromAnyRecB (toAnyRecA (AnyRecA x)) of
    Some r -> r.n
    None -> -1

-- TO_ANY (record) + FROM_ANY_TEMPLATE
anyRecordAsTemplate : Int -> Int
anyRecordAsTemplate x =
  case fromAnyTemplate @AnyBoxA (toAnyRecA (AnyRecA x)) of
    Some b -> b.n
    None -> -1

-- TO_ANY_TEMPLATE + FROM_ANY (record)
anyTemplateAsRecord : Int -> Int
anyTemplateAsRecord x =
  case fromAnyRecA (toAnyTemplate (AnyBoxA x)) of
    Some r -> r.n
    None -> -1

-- TYPE_REP (record A == A)
typeRepRecord : Int -> Bool
typeRepRecord x = repRecA == repRecA

-- TYPE_REP (record A == B)
typeRepRecordDiffer : Int -> Bool
typeRepRecordDiffer x = repRecA == repRecB

-- TYPE_REP (record vs template)
typeRepRecordVsTemplate : Int -> Bool
typeRepRecordVsTemplate x = repRecA == templateTypeRep @AnyBoxA

-- TEMPLATE_TYPE_REP (A == A)
typeRepTemplate : Int -> Bool
typeRepTemplate x = templateTypeRep @AnyBoxA == templateTypeRep @AnyBoxA

-- TEMPLATE_TYPE_REP (A == B)
typeRepTemplateDiffer : Int -> Bool
typeRepTemplateDiffer x = templateTypeRep @AnyBoxA == templateTypeRep @AnyBoxB

-- DA.Text.length
lenText : Text -> Int
