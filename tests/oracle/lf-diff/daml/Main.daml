-- HEX_TO_TEXT
hexToText : Text -> Text
hexToText x =
  case (C.fromHex x : Optional Text) of
    Some t -> t
    None -> "<none>"

-- SECP256K1_WITH_ECDSA_BOOL
secp256k1EcdsaOnly : Text -> Text -> Text -> Bool
secp256k1EcdsaOnly x y z = C.secp256k1WithEcdsaOnly x y z

-- SECP256K1_BOOL
secp256k1Hashed : Text -> Text -> Text -> Bool
secp256k1Hashed x y z = C.secp256k1 x y z

-- ANY_EXCEPTION_MESSAGE (user exception with a computed message)
exceptionMessageComputed : Int -> Text
exceptionMessageComputed x = message (toAnyException (CodeErr x))

-- ANY_EXCEPTION_MESSAGE (ArithmeticError)
exceptionMessageArithmetic : Text -> Text
exceptionMessageArithmetic x = message (toAnyException (ArithmeticError x))

-- ANY_EXCEPTION_MESSAGE
exceptionMessage : Text -> Text
exceptionMessage x = message (toAnyException (GeneralError x))

