module Tx where

import Daml.Script
import AssetHolding
import TxNote

summary : Party -> Script Text
summary who = do
  rows <- query @AssetHolding who
  pure (show [(c.assetSymbol, c.amount, c.owner, c.bank) | (_cid, c) <- rows])

parties : Script (Party, Party, Party)
parties = do
  bank <- allocateParty "Bank"
  owner <- allocateParty "Owner"
  auditor <- allocateParty "Auditor"
  pure (bank, owner, auditor)

holding : Party -> Party -> Party -> Decimal -> AssetHolding
holding bank owner auditor amount = AssetHolding with
  bank
  owner
  auditor
  assetSymbol = "USD"
  amount

seqProbe : Script Text
seqProbe = script do
  a <- allocateParty "A"
  b <- allocateParty "B"
  c <- allocateParty "C"
  d <- allocateParty "D"
  e <- allocateParty "E"
  f <- allocateParty "F"
  g <- allocateParty "G"
  h <- allocateParty "H"
  pure (show [a, b, c, d, e, f, g, h])

createOk : Script Text
createOk = script do
  (bank, owner, auditor) <- parties
  submit (actAs bank <> actAs owner) do
    createCmd (holding bank owner auditor 10.0)
  summary owner

ensureFail : Script Text
ensureFail = script do
  (bank, owner, auditor) <- parties
  err <- trySubmit (actAs bank <> actAs owner) do
    createCmd (holding bank owner auditor 0.0)
  pure (show err)

authFail : Script Text
authFail = script do
  (bank, owner, auditor) <- parties
  err <- trySubmit (actAs owner) do
    createCmd (holding bank owner auditor 10.0)
  pure (show err)

authBeforeEnsure : Script Text
authBeforeEnsure = script do
  (bank, owner, auditor) <- parties
  err <- trySubmit (actAs owner) do
    createCmd (holding bank owner auditor 0.0)
  pure (show err)

ensureNeg : Script Text
ensureNeg = script do
  (bank, owner, auditor) <- parties
  err <- trySubmit (actAs bank <> actAs owner) do
    createCmd (holding bank owner auditor (-1.0))
  pure (show err)

transferKeeps : Script Text
transferKeeps = script do
  (bank, owner, auditor) <- parties
  cid <- submit (actAs bank <> actAs owner) do
    createCmd (holding bank owner auditor 10.0)
  _ <- trySubmit (actAs owner) do
    exerciseCmd cid Transfer with newOwner = auditor
  summary owner

assertKeeps : Script Text
assertKeeps = script do
  (bank, owner, auditor) <- parties
  cid <- submit (actAs bank <> actAs owner) do
    createCmd (holding bank owner auditor 10.0)
  _ <- trySubmit (actAs owner) do
    exerciseCmd cid Transfer with newOwner = owner
  summary owner

transferOk : Script Text
transferOk = script do
  (bank, owner, auditor) <- parties
  cid <- submit (actAs bank <> actAs owner) do
    createCmd (holding bank owner auditor 10.0)
  submit (actAs owner) do
    exerciseCmd cid Transfer with newOwner = bank
  old <- summary owner
  moved <- summary bank
  pure (old <> "|" <> moved)

transferToAuditor : Script Text
transferToAuditor = script do
  (bank, owner, auditor) <- parties
  cid <- submit (actAs bank <> actAs owner) do
    createCmd (holding bank owner auditor 10.0)
  err <- trySubmit (actAs owner) do
    exerciseCmd cid Transfer with newOwner = auditor
  pure (show err)

doubleConsume : Script Text
doubleConsume = script do
  (bank, owner, auditor) <- parties
  cid <- submit (actAs bank <> actAs owner) do
    createCmd (holding bank owner auditor 10.0)
  submit (actAs owner) do
    exerciseCmd cid Transfer with newOwner = bank
  err <- trySubmit (actAs owner) do
    exerciseCmd cid Transfer with newOwner = auditor
  pure (show err)

