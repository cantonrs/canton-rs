observerTransfer : Script Text
observerTransfer = script do
  (bank, owner, auditor) <- parties
  cid <- submit (actAs bank <> actAs owner) do
    createCmd (holding bank owner auditor 10.0)
  err <- trySubmit (actAs auditor) do
    exerciseCmd cid Transfer with newOwner = bank
  pure (show err)

splitOk : Script Text
splitOk = script do
  (bank, owner, auditor) <- parties
  cid <- submit (actAs bank <> actAs owner) do
    createCmd (holding bank owner auditor 10.0)
  submit (actAs owner) do
    exerciseCmd cid SplitTransfer with
      transferAmount = 2.5
      recipient = bank
  left <- summary owner
  right <- summary bank
  pure (left <> "|" <> right)

