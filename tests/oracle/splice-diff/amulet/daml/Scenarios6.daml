  let c0 = case r0 of { Right c -> Some c; Left _ -> None }
  let s0 = stepPair r0
  r1 <- trySubmit (actAs dso_p) (createCmd (OpenMiningRound with dso = dso_p, round = (Round with number = 5), amuletPrice = 0.005, opensAt = (time (date 2026 Jan 1) 0 0 0), targetClosesAt = (time (date 2026 Jan 2) 0 0 0), issuingFor = (microseconds (0)), transferConfigUsd = (TransferConfig with createFee = (FixedFee with fee = 0.0), holdingFee = (RatePerRound with rate = 0.0000190259), transferFee = (SteppedRate with initialRate = 0.0, steps = []), lockHolderFee = (FixedFee with fee = 0.0), extraFeaturedAppRewardAmount = 1.0, maxNumInputs = 100, maxNumOutputs = 100, maxNumLockHolders = 50, tokenStandardMaxTTL = None), issuanceConfig = (IssuanceConfig with amuletToIssuePerYear = 40000000000.0, validatorRewardPercentage = 0.05, appRewardPercentage = 0.15, validatorRewardCap = 0.2, featuredAppRewardCap = 100.0, unfeaturedAppRewardCap = 0.6, optValidatorFaucetCap = None, optDevelopmentFundPercentage = None), tickDuration = (microseconds (600000000)), trafficPrice = None, rewardConfig = None))
  let c1 = case r1 of { Right c -> Some c; Left _ -> None }
  let s1 = stepPair r1
  r2 <- trySubmit (actAs dso_p) (createCmd (ExternalPartyConfigState with dso = dso_p, holdingFeesOpenRoundNumber = (Round with number = 5), amuletPrice = 0.005, transferConfig = (TransferConfigV2 with holdingFee = (RatePerRound with rate = 0.0000190259), maxNumInputs = 100, maxNumOutputs = 100, maxNumLockHolders = 50, tokenStandardMaxTTL = None), targetArchiveAfter = (time (date 2026 Jan 2) 0 0 0), rewardCalculationVersion = None, amuletSwitchOverTimes = None, governanceLockConfig = None, trafficPrice = None, supportedSynchronizerIds = None, minTrafficTopupAmount = None))
  let c2 = case r2 of { Right c -> Some c; Left _ -> None }
  let s2 = stepPair r2
  r3 <- trySubmit (actAs dso_p <> actAs other_p) (createCmd (Amulet with dso = dso_p, owner = other_p, amount = (ExpiringAmount with initialAmount = 100.0, createdAt = (Round with number = 1), ratePerRound = (RatePerRound with rate = 0.0000190259))))
  let c3 = case r3 of { Right c -> Some c; Left _ -> None }
  let s3 = stepPair r3
  setTime (time (date 2026 Jan 1) 0 1 0)
  let s4 = ("time", "")
  r5 <- trySubmit (actAs dso_p) (createCmd (ExternalPartyAmuletRules with dso = dso_p))
  let c5 = case r5 of { Right c -> Some c; Left _ -> None }
  let s5 = stepPair r5
  s6 <- case (c5, c2, c3) of
    (Some cid6, Some cidref2, Some cidref3) -> fmap stepPair (trySubmit (actAs dso_p <> actAs other_p) (exerciseCmd (toInterfaceContractId @AI1.AllocationFactory cid6) (AI1.AllocationFactory_Allocate with expectedAdmin = dso_p, allocation = (AL1.AllocationSpecification with settlement = (AL1.SettlementInfo with executor = sv2_p, settlementRef = (AL1.Reference with id = "settlement-1", cid = None), requestedAt = (time (date 2025 Dec 31) 23 1 0), allocateBefore = (time (date 2026 Jan 2) 0 1 0), settleBefore = (time (date 2026 Jan 3) 0 1 0), meta = (MD1.Metadata with values = (TextMap.fromList []))), transferLegId = "leg-1", transferLeg = (AL1.TransferLeg with sender = other_p, receiver = sv1_p, amount = 10.0, instrumentId = (HV1.InstrumentId with admin = dso_p, id = "Amulet"), meta = (MD1.Metadata with values = (TextMap.fromList [])))), requestedAt = (time (date 2025 Dec 31) 23 1 0), inputHoldingCids = [(toInterfaceContractId @HV1.Holding cidref3)], extraArgs = (MD1.ExtraArgs with context = (MD1.ChoiceContext with values = (TextMap.fromList [("external-party-config-state", (MD1.AV_ContractId (coerceContractId cidref2)))])), meta = (MD1.Metadata with values = (TextMap.fromList []))))))
