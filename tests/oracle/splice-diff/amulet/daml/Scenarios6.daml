  rows3 <- query @AmuletAllocation sv2_p
  let acs3 = sort ["{" <> "\"allocation.transferLeg.amount\":\"" <> show c.allocation.transferLeg.amount <> "\"" <> "}" | (_, c) <- rows3]
  rows4 <- query @AmuletAllocation sv1_p
  let acs4 = sort ["{" <> "\"allocation.transferLeg.amount\":\"" <> show c.allocation.transferLeg.amount <> "\"" <> "}" | (_, c) <- rows4]
  pure ("{\"name\":\"ax_dso_expire_by_executor\",\"steps\":" <> jsonList (map fst steps) <> ",\"details\":" <> jsonList (map snd steps) <> ",\"acs\":{" <> "\"Amulet@Dso\":" <> jsonObjList acs0 <> "," <> "\"LockedAmulet@Dso\":" <> jsonObjList acs1 <> "," <> "\"AmuletAllocation@Dso\":" <> jsonObjList acs2 <> "," <> "\"AmuletAllocation@Sv2\":" <> jsonObjList acs3 <> "," <> "\"AmuletAllocation@Sv1\":" <> jsonObjList acs4 <> "}}")

