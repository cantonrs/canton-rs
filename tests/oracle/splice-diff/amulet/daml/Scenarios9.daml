  r2 <- trySubmit (actAs dso_p <> actAs sv1_p) (createCmd (Amulet with dso = dso_p, owner = sv1_p, amount = (ExpiringAmount with initialAmount = 100.0, createdAt = (Round with number = 1), ratePerRound = (RatePerRound with rate = 0.0000190259))))
  let c2 = case r2 of { Right c -> Some c; Left _ -> None }
  let s2 = stepPair r2
  r3 <- trySubmit (actAs dso_p) (createCmd (FeaturedAppRight with dso = dso_p, provider = sv1_p, activityWeight = None, appKind = None, opsParties = None))
  let c3 = case r3 of { Right c -> Some c; Left _ -> None }
  let s3 = stepPair r3
  setTime (time (date 2026 Jan 1) 0 1 0)
  let s4 = ("time", "")
  s5 <- case (c0, c1, c2, c3) of
    (Some cid5, Some cidref1, Some cidref2, Some cidref3) -> fmap stepPair (trySubmit (actAs dso_p <> actAs sv1_p <> actAs other_p) (exerciseCmd cid5 (AmuletRules_Transfer with transfer = (Transfer with sender = sv1_p, provider = sv1_p, inputs = [(InputAmulet cidref2)], outputs = [(TransferOutput with receiver = other_p, receiverFeeRatio = 0.0, amount = 5.0, lock = None, meta = None)], beneficiaries = None), context = (TransferContext with openMiningRound = cidref1, issuingMiningRounds = (Map.fromList []), validatorRights = (Map.fromList []), featuredAppRight = (Some cidref3)), expectedDso = (Some dso_p))))
    _ -> pure ("skip", "")
  let steps = [s0, s1, s2, s3, s4, s5]
  rows0 <- query @FeaturedAppActivityMarker dso_p
  let acs0 = sort ["{" <> "\"provider\":\"" <> hint c.provider <> "\"" <> "," <> "\"beneficiary\":\"" <> hint c.beneficiary <> "\"" <> "," <> "\"weight\":\"" <> show c.weight <> "\"" <> "}" | (_, c) <- rows0]
  rows1 <- query @AppRewardCoupon dso_p
  let acs1 = sort ["{" <> "\"provider\":\"" <> hint c.provider <> "\"" <> "," <> "\"amount\":\"" <> show c.amount <> "\"" <> "}" | (_, c) <- rows1]
  rows2 <- query @Amulet dso_p
  let acs2 = sort ["{" <> "\"owner\":\"" <> hint c.owner <> "\"" <> "," <> "\"amount.initialAmount\":\"" <> show c.amount.initialAmount <> "\"" <> "}" | (_, c) <- rows2]
  pure ("{\"name\":\"ct_featured_transfer_markers_version_creates_a_marker\",\"steps\":" <> jsonList (map fst steps) <> ",\"details\":" <> jsonList (map snd steps) <> ",\"acs\":{" <> "\"FeaturedAppActivityMarker@Dso\":" <> jsonObjList acs0 <> "," <> "\"AppRewardCoupon@Dso\":" <> jsonObjList acs1 <> "," <> "\"Amulet@Dso\":" <> jsonObjList acs2 <> "}}")

