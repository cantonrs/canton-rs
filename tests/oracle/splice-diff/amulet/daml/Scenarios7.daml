hint : Party -> Text
hint p = case T.splitOn "-" (partyToText p) of
  (h :: _) -> h
  [] -> ""

jsonStr : Text -> Text
jsonStr t = "\"" <> jsonEscape t <> "\""

-- backslash first, then the quote and the control characters an error message may carry
jsonEscape : Text -> Text
jsonEscape = T.replace "\r" "\\r" . T.replace "\t" "\\t" . T.replace "\n" "\\n" . T.replace "\"" "\\\"" . T.replace "\\" "\\\\"

jsonList : [Text] -> Text
jsonList xs = "[" <> T.intercalate "," (map jsonStr xs) <> "]"

jsonObjList : [Text] -> Text
jsonObjList xs = "[" <> T.intercalate "," xs <> "]"

-- error category of a failed step; `other:<constructor>` marks a category not mapped yet
stepText : Either SubmitError a -> Text
stepText (Right _) = "ok"
stepText (Left e) = case e of
  AuthorizationError {} -> "auth"
  TemplatePreconditionViolated {} -> "precondition"
  ContractNotFound {} -> "not-found"
  FailureStatusError { failureStatus = fs } -> if T.isInfixOf "PreconditionFailed" fs.errorId then "precondition" else "exception"
  UnhandledException {} -> "exception"
  WronglyTypedContract {} -> "wrong-type"
  UserError {} -> "user-error"
  _ -> "other"

-- what a failed step says beyond its category (U-6): the message of an uncaught Daml exception, or the errorId and message
-- of a FailureStatus; empty for every other outcome
stepDetail : Either SubmitError a -> Text
stepDetail (Right _) = ""
stepDetail (Left e) = case e of
  UnhandledException (Some exc) -> "unhandled:" <> EX.message exc
  UnhandledException None -> "unhandled:"
  FailureStatusError { failureStatus = fs } -> "failure:" <> fs.errorId <> "|" <> fs.message
  AuthorizationError msg -> "auth:" <> msg
  _ -> ""

stepPair : Either SubmitError a -> (Text, Text)
stepPair r = (stepText r, stepDetail r)

