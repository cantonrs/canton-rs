    (Some cid4, Some cidref0, Some cidref1, Some cidref2) -> fmap stepPair (trySubmit (actAs dso_p <> actAs sv1_p) (exerciseCmd cid4 (AmuletRules_CreateTransferPreapproval with context = (PaymentTransferContext with amuletRules = cidref0, context = (TransferContext with openMiningRound = cidref1, issuingMiningRounds = (Map.fromList []), validatorRights = (Map.fromList []), featuredAppRight = None)), inputs = [(InputAmulet cidref2)], receiver = sv1_p, provider = sv1_p, expiresAt = (time (date 2028 Sep 27) 0 1 0), expectedDso = (Some dso_p), optCreatedAt = None)))
    _ -> pure ("skip", "")
  let steps = [s0, s1, s2, s3, s4]
  rows0 <- query @TransferPreapproval dso_p
  let acs0 = sort ["{" <> "\"receiver\":\"" <> hint c.receiver <> "\"" <> "," <> "\"provider\":\"" <> hint c.provider <> "\"" <> "," <> "\"validFrom\":\"" <> show (convertRelTimeToMicroseconds (subTime c.validFrom (time (date 1970 Jan 1) 0 0 0))) <> "\"" <> "," <> "\"lastRenewedAt\":\"" <> show (convertRelTimeToMicroseconds (subTime c.lastRenewedAt (time (date 1970 Jan 1) 0 0 0))) <> "\"" <> "," <> "\"expiresAt\":\"" <> show (convertRelTimeToMicroseconds (subTime c.expiresAt (time (date 1970 Jan 1) 0 0 0))) <> "\"" <> "}" | (_, c) <- rows0]
  rows1 <- query @Amulet dso_p
  let acs1 = sort ["{" <> "\"owner\":\"" <> hint c.owner <> "\"" <> "," <> "\"amount.initialAmount\":\"" <> show c.amount.initialAmount <> "\"" <> "," <> "\"amount.createdAt.number\":\"" <> show c.amount.createdAt.number <> "\"" <> "}" | (_, c) <- rows1]
  pure ("{\"name\":\"tp_create_paid_long\",\"steps\":" <> jsonList (map fst steps) <> ",\"details\":" <> jsonList (map snd steps) <> ",\"acs\":{" <> "\"TransferPreapproval@Dso\":" <> jsonObjList acs0 <> "," <> "\"Amulet@Dso\":" <> jsonObjList acs1 <> "}}")

