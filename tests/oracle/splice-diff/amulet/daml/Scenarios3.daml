  let acs2 = sort ["{" <> "\"user\":\"" <> hint c.user <> "\"" <> "," <> "\"amount\":\"" <> show c.amount <> "\"" <> "}" | (_, c) <- rows2]
  pure ("{\"name\":\"mt_buy_insufficient_input\",\"steps\":" <> jsonList (map fst steps) <> ",\"details\":" <> jsonList (map snd steps) <> ",\"acs\":{" <> "\"MemberTraffic@Dso\":" <> jsonObjList acs0 <> "," <> "\"Amulet@Dso\":" <> jsonObjList acs1 <> "," <> "\"ValidatorRewardCoupon@Dso\":" <> jsonObjList acs2 <> "}}")

