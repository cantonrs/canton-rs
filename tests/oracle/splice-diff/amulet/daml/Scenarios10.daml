  s2 <- case (c0, c1) of
    (Some cid2, Some cidref1) -> fmap stepPair (trySubmit (actAs sv1_p <> readAs dso_p) (exerciseCmd cid2 (AmuletRules_Mint with receiver = sv1_p, amount = 10.0, openRound = cidref1, reason = None)))
    _ -> pure ("skip", "")
  let steps = [s0, s1, s2]
  rows0 <- query @Amulet dso_p
  let acs0 = sort ["{" <> "\"owner\":\"" <> hint c.owner <> "\"" <> "," <> "\"amount.initialAmount\":\"" <> show c.amount.initialAmount <> "\"" <> "}" | (_, c) <- rows0]
  rows1 <- query @LockedAmulet dso_p
  let acs1 = sort ["{" <> "\"amulet.owner:party\":\"" <> hint c.amulet.owner <> "\"" <> "," <> "\"amulet.amount.initialAmount\":\"" <> show c.amulet.amount.initialAmount <> "\"" <> "," <> "\"lock.expiresAt:time\":\"" <> show (convertRelTimeToMicroseconds (subTime c.lock.expiresAt (time (date 1970 Jan 1) 0 0 0))) <> "\"" <> "}" | (_, c) <- rows1]
  rows2 <- query @AmuletTransferInstruction dso_p
  let acs2 = sort ["{" <> "\"transfer.sender:party\":\"" <> hint c.transfer.sender <> "\"" <> "," <> "\"transfer.receiver:party\":\"" <> hint c.transfer.receiver <> "\"" <> "," <> "\"transfer.amount\":\"" <> show c.transfer.amount <> "\"" <> "," <> "\"transfer.executeBefore:time\":\"" <> show (convertRelTimeToMicroseconds (subTime c.transfer.executeBefore (time (date 1970 Jan 1) 0 0 0))) <> "\"" <> "}" | (_, c) <- rows2]
  rows3 <- query @AmuletTransferInstruction sv1_p
  let acs3 = sort ["{" <> "\"transfer.amount\":\"" <> show c.transfer.amount <> "\"" <> "}" | (_, c) <- rows3]
  rows4 <- query @AmuletTransferInstruction other_p
  let acs4 = sort ["{" <> "\"transfer.amount\":\"" <> show c.transfer.amount <> "\"" <> "}" | (_, c) <- rows4]
  pure ("{\"name\":\"ra_nested_fetch_of_a_dso_round_reading_the_dso\",\"steps\":" <> jsonList (map fst steps) <> ",\"details\":" <> jsonList (map snd steps) <> ",\"acs\":{" <> "\"Amulet@Dso\":" <> jsonObjList acs0 <> "," <> "\"LockedAmulet@Dso\":" <> jsonObjList acs1 <> "," <> "\"AmuletTransferInstruction@Dso\":" <> jsonObjList acs2 <> "," <> "\"AmuletTransferInstruction@Sv1\":" <> jsonObjList acs3 <> "," <> "\"AmuletTransferInstruction@Other\":" <> jsonObjList acs4 <> "}}")

runAll : Script [Text]
runAll = sequence [sc_ct_featured_transfer_traffic_round_creates_no_marker, sc_ct_unfeatured_transfer_traffic_round, sc_ct_convert_markers_in_a_markers_round, sc_ct_convert_markers_in_a_traffic_round_only_archives, sc_ct_convert_markers_in_a_markers_version_round, sc_ra_transfer_as_sender_reading_the_dso, sc_ra_transfer_as_sender_without_read_as, sc_ra_transfer_read_as_a_party_that_sees_nothing, sc_ra_transfer_read_as_the_receiver, sc_ra_transfer_read_as_two_parties, sc_ra_transfer_as_dso_reading_the_sender_has_no_sender_authority, sc_ra_transfer_same_party_in_act_as_and_read_as, sc_ra_transfer_both_actors_reading_the_dso, sc_ra_instruction_accept_as_receiver_reading_the_dso, sc_ra_instruction_accept_as_receiver_without_read_as, sc_ra_instruction_withdraw_as_sender_reading_the_dso, sc_ra_instruction_reject_as_receiver_reading_the_dso, sc_ra_allocation_as_authorizer_reading_the_dso, sc_ra_allocation_v2_as_authorizer_reading_the_dso, sc_ra_allocation_settle_as_executor_reading_the_dso, sc_ra_allocation_v2_settle_as_executor_reading_the_dso, sc_ra_allocation_v2_settle_as_executor_without_read_as, sc_ra_settle_batch_as_executor_reading_the_dso, sc_ra_settle_batch_as_executor_without_read_as, sc_ra_preapproval_send_as_sender_reading_the_dso, sc_ra_preapproval_send_as_sender_without_read_as, sc_ra_transfer_command_send_as_delegate_reading_the_dso, sc_ra_transfer_command_create_as_sender_reading_the_dso, sc_ra_create_an_amulet_needs_the_owner_and_the_dso_to_act, sc_ra_exercise_a_dso_choice_reading_the_dso, sc_ra_exercise_a_dso_choice_acting_as_the_dso_reading_nobody, sc_ra_nested_fetch_of_a_dso_round_reading_the_dso]
