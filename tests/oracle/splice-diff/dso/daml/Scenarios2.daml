    (Some cid12, ((cidfound_AnsEntryContext_Dso_0_, _) :: _), ((cidfound_TerminatedSubscription_Dso_0_, _) :: _)) -> fmap stepPair (trySubmit (actAs sv1_p <> readAs dso_p) (exerciseCmd cid12 (DsoRules_TerminateSubscription with ansEntryContextCid = cidfound_AnsEntryContext_Dso_0_, terminatedSubscriptionCid = cidfound_TerminatedSubscription_Dso_0_, sv = (Some sv1_p))))
    _ -> pure ("skip", "")
  setTime (time (date 2026 Jan 3) 0 0 0)
  let s13 = ("time", "")
  qf_AnsEntry_Dso__14 <- query @AnsEntry dso_p
  s14 <- case (c0, qf_AnsEntry_Dso__14) of
    (Some cid14, ((cidfound_AnsEntry_Dso_0_, _) :: _)) -> fmap stepPair (trySubmit (actAs sv1_p <> readAs dso_p) (exerciseCmd cid14 (DsoRules_ExpireAnsEntry with ansEntryCid = cidfound_AnsEntry_Dso_0_, choiceArg = (AnsEntry_Expire with actor = dso_p), sv = (Some sv1_p))))
    _ -> pure ("skip", "")
  let steps = [s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14]
  rows0 <- query @Confirmation dso_p
  let acs0 = sort ["{" <> "\"confirmer\":\"" <> hint c.confirmer <> "\"" <> "}" | (_, c) <- rows0]
  rows1 <- query @DsoRules dso_p
  let acs1 = sort ["{" <> "\"epoch\":\"" <> show c.epoch <> "\"" <> "," <> "\"svs#weights\":\"" <> T.intercalate ";" (sort [hint p <> ":" <> show i.svRewardWeight | (p, i) <- Map.toList c.svs]) <> "\"" <> "}" | (_, c) <- rows1]
  rows2 <- query @AnsEntry dso_p
  let acs2 = sort ["{" <> "\"name\":\"" <> c.name <> "\"" <> "," <> "\"user\":\"" <> hint c.user <> "\"" <> "}" | (_, c) <- rows2]
  rows3 <- query @Amulet dso_p
  let acs3 = sort ["{" <> "\"owner\":\"" <> hint c.owner <> "\"" <> "}" | (_, c) <- rows3]
  rows4 <- query @AnsEntryContext dso_p
  let acs4 = sort ["{" <> "\"name\":\"" <> c.name <> "\"" <> "}" | (_, c) <- rows4]
  rows5 <- query @TerminatedSubscription dso_p
  let acs5 = sort ["{" <> "\"subscriptionData.description\":\"" <> show c.subscriptionData.description <> "\"" <> "}" | (_, c) <- rows5]
  pure ("{\"name\":\"rules_expire_ans_entry_and_terminate_subscription\",\"steps\":" <> jsonList (map fst steps) <> ",\"details\":" <> jsonList (map snd steps) <> ",\"acs\":{" <> "\"Confirmation@Dso\":" <> jsonObjList acs0 <> "," <> "\"DsoRules@Dso\":" <> jsonObjList acs1 <> "," <> "\"AnsEntry@Dso\":" <> jsonObjList acs2 <> "," <> "\"Amulet@Dso\":" <> jsonObjList acs3 <> "," <> "\"AnsEntryContext@Dso\":" <> jsonObjList acs4 <> "," <> "\"TerminatedSubscription@Dso\":" <> jsonObjList acs5 <> "}}")

