-- ledger-level cases: a Text with a NUL character that enters or leaves a contract
template Holder
  with
    owner : Party
    t : Text
  where
    signatory owner
    choice MakeNul : Text
      controller owner
      do _ <- create Holder with owner, t = fromNul "00"
         pure "made"
    choice KeepNul : Text
      controller owner
      do pure (fromNul "00")

fromNul : Text -> Text
fromNul h = case (C.fromHex h : Optional Text) of
  Some t -> t
  None -> "<none>"

createWithNulArgument : Script Text
createWithNulArgument = do
  a <- allocateParty "Alice"
  _ <- submit a (createCmd (Holder with owner = a, t = fromNul "00"))
  pure "created"

createNulInsideAChoice : Script Text
createNulInsideAChoice = do
  a <- allocateParty "Alice"
  cid <- submit a (createCmd (Holder with owner = a, t = "x"))
  r <- submit a (exerciseCmd cid MakeNul)
  pure r

